{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                l.id, l.code, l.long_url,\n                d.domain as \"domain?\",\n                l.expires_at, l.permanent, l.deleted_at, l.created_at\n            FROM links l\n            LEFT JOIN domains d ON d.id = l.domain_id\n            WHERE l.long_url = $1 AND l.domain_id = $2 AND l.deleted_at IS NULL\n            ",
