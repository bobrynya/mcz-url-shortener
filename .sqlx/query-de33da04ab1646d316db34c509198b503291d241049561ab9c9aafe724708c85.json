{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, domain, is_default, is_active, description, created_at, updated_at, deleted_at\n            FROM domains\n            WHERE deleted_at IS NULL\n              AND ($1::boolean IS NULL OR is_active = $1)\n            ORDER BY is_default DESC, domain\n            ",
