{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                l.id, l.code, l.long_url,\n                d.domain as \"domain?\",\n                l.expires_at, l.permanent, l.deleted_at, l.created_at\n            FROM links l\n            LEFT JOIN domains d ON d.id = l.domain_id\n            WHERE ($1::bigint IS NULL OR l.domain_id = $1)\n            ORDER BY l.created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
